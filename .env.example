# ─── Database ───────────────────────────────────────────────────────────
# MySQL 8 connection string. Local dev uses docker-compose (port 3309).
# Azure Database for MySQL requires TLS: add ?sslaccept=strict
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL="mysql://root:root@localhost:3309/mtn_scholars"

# ─── Security ───────────────────────────────────────────────────────────
# Signs session cookies and hashes one-time codes. 32+ random characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=""

# Public URL of the site, no trailing slash. Used for links and logos in emails.
APP_URL="https://vote.example.com"

# ─── Email (ZeptoMail) ──────────────────────────────────────────────────
# "Send Mail Token" from ZeptoMail → Mail Agents → SMTP/API. Paste the token
# with or without the "Zoho-enczapikey " prefix.
# In development, leave empty to print emails (and OTPs) to the terminal instead.
ZEPTOMAIL_TOKEN=""
# Change only if your ZeptoMail account is in another region (e.g. api.zeptomail.eu).
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"
MAIL_FROM_ADDRESS="mtnfscholars@dragnet-solutions.com"
MAIL_FROM_NAME="MTN Foundation Scholarship"
# Local development only: true = never send; print emails to the terminal and show OTP codes on screen.
# Ignored in production.
MAIL_DRY_RUN="false"
# Shown to scholars for help, and used as the email Reply-To.
SUPPORT_EMAIL="mtnfscholars@dragnet-solutions.com"

# ─── First admin (used once by `npm run db:seed`) ───────────────────────
ADMIN_SEED_NAME="Administrator"
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
